# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows scripts need CRLF to run reliably with cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.bmp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
